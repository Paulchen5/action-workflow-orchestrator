root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

[*.json]
indent_size = 4
indent_style = space

[*.{js,ts}]
indent_size = 4
indent_style = space

[*.{yaml,yml}]
indent_size = 2
indent_style = space

[*.md]
indent_size = 4
indent_style = space
trim_trailing_whitespace = false

[Makefile]
indent_size = 4
indent_style = tab

[package.json]
indent_size = 2
indent_style = space

[package-lock.json]
indent_size = 2
indent_style = space
