{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "bracketSpacing": true,
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "always",
    "overrides": [
        {
            "files": "*.{yaml,yml}",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
